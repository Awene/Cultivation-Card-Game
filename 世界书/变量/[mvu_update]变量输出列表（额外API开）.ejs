---
<%_ /* 额外API模式·记录模型视图：
       - 保留「事件」，供记录模型执行事件阶段推进与归档
       - 世界推进开启时显示传闻供记录员更新，其他回合保持隐藏
       - 移除各 NPC 的「细节可见」开关字段(纯前端偏好)
       - 但【保留】各 NPC 的物品/功法/装备/傀儡/灵兽——记录员需看到全量才能准确更新变量，
         「眼睛隐藏细节」只作用于剧情模型，不作用于记录模型 */ _%>
<status_current_variable>
<%_ {
  const data = getMessageVar('stat_data', { defaults: {} });
  const cleanData = _.omit(_.cloneDeep(data), ['传闻', '性器', '__custom_start__']);
  // 提示词读取时兼容尚未迁移的旧存档，仅转换副本。
  // BEGIN CULTIVATION_TASKS (源: 前端 util/cultivation-tasks.js)
  /** 将旧任务字典迁移为管理字段 + 条目；不修改输入，也不重发奖励。 @param {any} input @returns {any} */
  function normalizeTasks(input) {
    const record = value => value && typeof value === 'object' && !Array.isArray(value);
    const source = record(input) ? input : {};
    const entries = Object.fromEntries(Object.entries(source).filter(([key, value]) =>
      !['聚焦任务', '已完成任务', '条目'].includes(key) && record(value)));
    if (record(source.条目)) Object.assign(entries, source.条目);
    const completed = Array.isArray(source.已完成任务)
      ? [...new Set(source.已完成任务.filter(name => typeof name === 'string').map(name => name.trim()).filter(Boolean))]
      : [];
    const focused = typeof source.聚焦任务 === 'string' ? source.聚焦任务.trim() : '';
    return {
      聚焦任务: focused && Object.hasOwn(entries, focused) ? focused : null,
      已完成任务: completed,
      条目: entries,
    };
  }
  // END CULTIVATION_TASKS
  cleanData.任务 = normalizeTasks(cleanData.任务);
  let active = []; try { active = JSON.parse(getvar('路由激活规则') || '[]'); } catch (_) {}
  if (Array.isArray(active) && active.includes('[时间推进规则]')) cleanData.传闻 = _.cloneDeep(data.传闻);
  // 生日与上次突破时间点只供本地 MVU 核验，不进入任何 AI 提示词。
  if (cleanData.寿元 && typeof cleanData.寿元 === 'object') {
    delete cleanData.寿元.生日; delete cleanData.寿元.冥族停龄;
  }
  if (cleanData.修炼进度 && typeof cleanData.修炼进度 === 'object') {
    delete cleanData.修炼进度.上次突破时间点;
  }
  const _rel = cleanData.关系列表;
  if (_rel && typeof _rel === 'object') {
    for (const _n of Object.keys(_rel)) {
      const _npc = _rel[_n];
      if (_npc && typeof _npc === 'object') {
        delete _npc.细节可见; delete _npc.性器;
        if (_npc.修炼进度 && typeof _npc.修炼进度 === 'object') {
          delete _npc.修炼进度.上次突破时间点;
        }
        if (_npc.寿元 && typeof _npc.寿元 === 'object') {
          delete _npc.寿元.生日; delete _npc.寿元.冥族停龄;
        }
      }
    }
  }
_%>
<%= YAML.stringify(cleanData, { blockQuote: 'literal' }) _%>
<%_ } _%>
</status_current_variable>
