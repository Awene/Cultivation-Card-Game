{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cultivation-illustration-workshop",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-02",
  "workers_dev": true,
  "vars": {
    "DISCORD_CLIENT_ID": "1533494278263935108",
    "ADMIN_DISCORD_IDS": "808684321153482812",
    "PUBLIC_BASE_URL": "https://cultivation-illustration-workshop.awenewilly1.workers.dev",
    "DISCORD_REDIRECT_URI": "https://cultivation-illustration-workshop.awenewilly1.workers.dev/auth/discord/callback",
    "STORAGE_SOFT_LIMIT_BYTES": "9000000000",
    "STORAGE_TARGET_BYTES": "8500000000",
    "PACK_GRACE_PERIOD_DAYS": "30"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cultivation-workshop-db",
      "database_id": "e4ff7a37-a2a7-4253-83b2-a1e4cb9e5036",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "cultivation-workshop-images"
    }
  ],
  "secrets": {
    "required": ["DISCORD_CLIENT_SECRET", "SESSION_SECRET"]
  }
}
