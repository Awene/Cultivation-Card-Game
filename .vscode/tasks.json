{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "规则路由：List",
      "type": "process",
      "command": "node",
      "args": [
        "router_sync.mjs",
        "list"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "规则路由：Pull",
      "type": "process",
      "command": "node",
      "args": [
        "router_sync.mjs",
        "pull",
        "${input:routerPreset}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "规则路由：Push",
      "type": "process",
      "command": "node",
      "args": [
        "router_sync.mjs",
        "push",
        "${input:routerPreset}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "规则路由：Push（强制替换）",
      "type": "process",
      "command": "node",
      "args": [
        "router_sync.mjs",
        "push",
        "${input:routerPreset}",
        "--force"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "routerPreset",
      "type": "promptString",
      "description": "输入 router_sync.config.json 中的预设名称",
      "default": "本格修仙"
    }
  ]
}
